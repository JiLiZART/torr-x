{
  "name": "torrentx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev:web": "pnpm --filter @torrentx/web dev",
    "dev:server": "cargo run -p torrentx-server --",
    "dev:desktop": "pnpm --filter @torrentx/desktop tauri dev",
    "build:web": "pnpm --filter @torrentx/web build",
    "build:server": "pnpm build:web && ./scripts/fetch-geoip.sh && cargo build --release -p torrentx-server --features geoip",
    "build:desktop": "pnpm build:web && ./scripts/fetch-geoip.sh && pnpm --filter @torrentx/desktop tauri build --features geoip",
    "lint": "node packages/ui/scripts/check-i18n.mjs && eslint apps/web/src packages/*/src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @torrentx/ui test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "5.9.3"
  }
}

{
  "name": "torrentx",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev:web": "pnpm --filter @torrentx/web dev",
    "dev:server": "cargo run -p torrentx-server --",
    "dev:desktop": "cross-env TORRENTX_UI_DEV_URL=http://localhost:1420 pnpm --filter @torrentx/desktop tauri dev",
    "build:web": "pnpm --filter @torrentx/web build",
    "fetch:geoip": "node scripts/fetch-geoip.mjs",
    "build:server": "pnpm build:web && pnpm fetch:geoip && cargo build --release -p torrentx-server --features geoip",
    "build:desktop": "pnpm build:web && pnpm fetch:geoip && pnpm --filter @torrentx/desktop tauri build --features geoip",
    "build:desktop:macos": "pnpm build:desktop --target universal-apple-darwin",
    "build:desktop:windows": "pnpm build:desktop --bundles msi,nsis",
    "build:desktop:linux": "pnpm build:desktop --bundles appimage,deb",
    "lint": "node packages/ui/scripts/check-i18n.mjs && node packages/ui/scripts/check-colors.mjs && eslint apps/web/src packages/*/src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "5.9.3"
  }
}
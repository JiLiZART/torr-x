{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorrentX",
  "version": "0.2.0",
  "identifier": "org.torrenthx.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "pnpm --filter @torrentx/web dev"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}